# Data (too large for git; document how to regenerate instead)
data/raw/
data/processed/
*.zip

# Ultralytics full run artifacts (checkpoints/logs) -- large, regenerable; the
# small best_model.pt copy in models/ IS committed on purpose (see README)
runs/
*.cache

# annotated/ is regenerated per predict.py run and can grow unbounded;
# the plastic_predictions.csv itself is committed on purpose
outputs/predictions/annotated/

# Generic pretrained checkpoints auto-downloaded by Ultralytics (not our
# trained model -- that's models/plastic_detector/best_model.pt, which IS committed)
/yolo*.pt
/weights/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
venv/
.venv/
*.egg-info/

# OS
.DS_Store
Thumbs.db

# Large trained weights (~98 MB): kept on Google Drive (MyDrive/suim/suim_unet.pt);
# the small config + test-metrics JSONs next to it ARE committed.
models/coral_segmenter/*.pt
# Coralscapes SegFormer v2 weights (~110 MB, over GitHub's 100 MB limit): on Google Drive
# (MyDrive/coralscapes/coralscapes_segformer_v2/); its config.json and the metrics JSONs ARE committed.
models/coral_segmenter/**/*.safetensors

# Fish-only training set built from FathomNet + TrashCan (regenerable)
data/processed_fish/

# Cached prediction pickles and the (not adopted) fish detector weights - regenerable / on Drive
outputs/experiments/**/*.pkl
models/fish_detector/*.pt

# Copernicus NetCDF downloads and Allen Coral Atlas GeoJSON (environmental risk module)
*.nc
*.geojson
